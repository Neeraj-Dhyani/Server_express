{{> navbar}}

<div class="container mt-4">

  <h3 class="mb-4">All Banners</h3>

  <div class="row">
    {{#each allBanners}}
      <div class="col-md-4 mb-4">

        <div class="card shadow-sm h-100">

          <!-- Image -->
          <img src="{{this.image}}" class="card-img-top" style="height:220px; object-fit:cover;">

          <div class="card-body">

            <h5 class="card-title">{{this.title}}</h5>

            <p class="text-muted">{{this.subtitle}}</p>

            <span class="badge bg-success">{{this.offer}}</span>

            <p class="mt-2">
              Coupon: 
              <strong>{{this.coupon}}</strong>
            </p>

            <p class="small text-secondary">
              Created: {{Date this.createdAt}}
            </p>

          </div>

          <div class="card-footer d-flex justify-content-between">

            <a href="/admin/editbanner/{{this._id}}" 
               class="btn btn-sm btn-primary">
               Edit
            </a>

            <button 
              onclick="deleteBanner('{{this._id}}')" 
              class="btn btn-sm btn-danger">
              Delete
            </button>

          </div>

        </div>

      </div>
    {{/each}}
  </div>

</div>