<div class="container mt-5"> 
  <div class="card shadow-lg p-4"> 
    <h2 class="mb-4 text-primary">Add New Category</h2> 

    <form method="post" action="http://localhost:5000/createcategory?key={{{apikey}}}">
      <div class="mb-3"> 
        <label class="form-label">Category</label> 
        <input 
          type="text" 
          name="itemCode" 
          class="form-control" 
          placeholder="Enter category name" 
          required
        > 
      </div> 

      <button type="submit" class="btn btn-primary w-100">
        Add Category
      </button>
    </form>

    <a class="btn btn-outline-primary w-100 mt-3" href="/admin/allCategory">
      Show All Categories
    </a>   
  </div>
</div>

{{#if success}}
<script>
  Swal.fire({
    icon: 'success',
    title: 'Category Added',
    text: 'Category added successfully!',
    confirmButtonColor: '#0d6efd'
  });
</script>
{{/if}}

{{#if error}}
<script>
  Swal.fire({
    icon: 'error',
    title: 'Error',
    text: 'Category not added. Please try again.',
    confirmButtonColor: '#dc3545'
  });
</script>
{{/if}}


    
