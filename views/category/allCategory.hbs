<table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Id</th>
      <th scope="col">Delete</th>
    </tr>
  </thead>  
  <tbody id="table_body">
  </tbody>
  
</table>
<script>
     let table_body = document.querySelector("#table_body");
    fetch("http://localhost:5000/getallcategory?key=4eee4f5e4bb456e050fe19f4dbe1f5d1b4f605b231105e268896f74788342a6b", {
    }).then(item=>{return item.json()}).then((item)=>{
      console.log(item)
        let row  = document.createElement("tr")
        item.category.forEach((item)=>{
          row.innerHTML = 
        `<td>${item.name}</td>
          <td>${item._id}</td>
          
          
          <td>
            <button class="btn btn-danger btn-sm delete-btn">
              <span class="material-symbols-outlined" id="deleteCategory" data-id="${item._id}">delete</span>
            </button>
          </td>

         
        `;
        })
            table_body.appendChild(row)
        })
        .catch(err=>{
        console.log(err)
    })
    document.addEventListener("click", (e)=>{
      console.log(e)
      if(e.target.id === "deleteCategory"){
        Swal.fire({
            title: "Do you want to Delete this Category?",
            icon:"warning",
            showDenyButton: true,
            showCancelButton: true,
            confirmButtonText: "Delete",
            denyButtonText: `Don't Delete`
        }).then((result) => {
            if (result.isConfirmed) {
            fetch(`http://localhost:5000/deletecategory/${e.target.dataset.id}`, {
            method:"delete"
          }).then(item=>item.json())
          .then(data=>{
            if(data.success === true){
               Swal.fire(data.msg, "", "success");
            }
          }).catch(err=>{
             Swal.fire("Somthing Went Wrong!", "", "error");;
          })
           
           } else if (result.isDenied) {
           Swal.fire("Denied", "", "info");
          }
        });
         
      }
    })
</script>