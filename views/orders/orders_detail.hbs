{{>navbar}}
<div class="container my-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Order Details</h2>
    <span class="badge 
      {{#if (equal order.status "delivered")}}bg-success
      {{else if (equal order.status "pending")}}bg-warning
      {{else}}bg-secondary{{/if}}">
      {{order.status}}
    </span>
  </div>

  <div class="card mb-4 shadow-sm">
    <div class="card-body row">
      <div class="col-md-6">
        <p><strong>Order ID:</strong> {{order._id}}</p>
        <p><strong>Order Date:</strong> {{Date order.orderDate}}</p>
        <p><strong>Shipping Method:</strong> {{order.shippingMethod}}</p>
      </div>
      <div class="col-md-6">
        <p><strong>Total Amount:</strong> ₹{{order.totalAmount}}</p>
        <p><strong>Status:</strong> {{order.status}}</p>
      </div>
    </div>
  </div>

  <div class="card mb-4 shadow-sm">
    <div class="card-header fw-bold">
      Customer Information
    </div>
    <div class="card-body">
      <p><strong>Name:</strong> {{order.customerName}}</p>
      <p><strong>Email:</strong> {{order.customerEmail}}</p>
      <p><strong>Address:</strong> {{order.customerAddress}}</p>
    </div>
  </div>

  <!-- Products Table -->
  <div class="card shadow-sm">
    <div class="card-header fw-bold">
      Ordered Products
    </div>
    <div class="card-body p-0">
      <table class="table table-striped mb-0">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th>Product Name</th>
            <th>Quantity</th>
            <th>Price (₹)</th>
            <th>Subtotal (₹)</th>
          </tr>
        </thead>
        <tbody>
          {{#each order.products}}
          <tr>
            <td>{{@index}}</td>
            <td>{{this.name}}</td>
            <td>{{this.quantity}}</td>
            <td>{{this.price}}</td>
            <td>{{multiply this.quantity this.price}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

</div>