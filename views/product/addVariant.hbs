<div class="container mt-5">
  <div class="card shadow-lg p-4">
    <h3 class="text-primary mb-4 text-center">Add Product Variant</h3>

    <form
      id="variantForm"
      method="post"
      action="/uploadproductimg/{{id}}?_method=PUT"
      enctype="multipart/form-data"
    >

      <div class="mb-3">
        <label class="form-label">Color</label>
        <input
          type="text"
          class="form-control"
          name="color"
          placeholder="e.g. Red"
          required
        >
      </div>

      <div class="mb-3">
        <label class="form-label">Sizes</label>
        <input
          type="text"
          class="form-control"
          name="size"
          placeholder="S M L XL"
        >
        <small class="text-muted">Separate sizes with space</small>
      </div>

      <div class="mb-3">
        <label class="form-label">Upload Images</label>
        <input
          type="file"
          class="form-control"
          name="images"
          multiple
          required
        >
      </div>

      <div class="d-flex justify-content-between">
        <a href="/admin/allProduct" class="btn btn-outline-secondary">
          Cancel
        </a>
        <button type="submit" class="btn btn-primary px-4">
          Add Variant
        </button>
      </div>

    </form>
  </div>
</div>
{{#if success}}
<script>
  Swal.fire({
  icon: 'success',
  title: 'Variant Added',
  text: 'Product variant added successfully!',
  confirmButtonColor: '#0d6efd'
  })
</script>
{{/if}}
{{#if error}}
<script>
  Swal.fire({
  icon: 'error',
  title: 'Variant Added',
  text: 'Product Variant not added Successfully!',
  confirmButtonColor: '#0d6efd'
  })
</script>
{{/if}}

