<h2 class="text-center text-primary mb-4">Edit Product</h2>

<form method="post" action="http://localhost:5000/updateProduct/{{product_data._id}}?_method=PUT">
  <div class="container">
    <div class="card shadow-lg p-4">
      
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Item Code</label>
          <input
            type="text"
            class="form-control"
            name="itemCode"
            value="{{product_data.itemCode}}"
            required
          >
        </div>

        <div class="col-md-6 mb-3">
          <label class="form-label">Product Name</label>
          <input
            type="text"
            class="form-control"
            name="name"
            value="{{product_data.name}}"
            required
          >
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Category</label>
          <input
            type="text"
            class="form-control"
            name="category"
            value="{{product_data.category}}"
          >
        </div>

        <div class="col-md-3 mb-3">
          <label class="form-label">Price</label>
          <input
            type="number"
            class="form-control"
            name="price"
            value="{{product_data.price}}"
          >
        </div>

        <div class="col-md-3 mb-3">
          <label class="form-label">GST (%)</label>
          <input
            type="number"
            class="form-control"
            name="gst"
            value="{{product_data.gst}}"
          >
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea
          class="form-control"
          name="description"
          rows="3"
        >{{product_data.description}}</textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Note</label>
        <textarea
          class="form-control"
          name="note"
          rows="2"
        >{{product_data.note}}</textarea>
      </div>

      <div class="d-flex justify-content-between mt-4">
        <a href="/admin/allProduct" class="btn btn-outline-secondary">
          Cancel
        </a>
        <button type="submit" class="btn btn-primary px-4">
          Update Product
        </button>
      </div>

    </div>
  </div>
</form>
