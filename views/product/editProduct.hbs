{{>navbar}}
<h2 class="text-center text-primary mb-4">Edit Product</h2>

<form id="form_data">
  <div class="container">
    <div class="card shadow-lg p-4">
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Item Code</label>
          <input
            type="text"
            class="form-control"
            name="itemCode"
            value="{{product_data.itemCode}}"
            required
          >
        </div>

        <div class="col-md-6 mb-3">
          <label class="form-label">Product Name</label>
          <input
            type="text"
            class="form-control"
            name="name"
            value="{{product_data.name}}"
            required
          >
        </div>
        <div class="mb-3">
        <label class="form-label">Product Titel</label>
        <input
          class="form-control"
          name="product_titel"
          rows="2"
          value="{{product_data.product_title}}"
        >
      </div>
      <div class="mb-3">
        <label class="form-label">Product Details</label>
        <input
          class="form-control"
          name="product_details"
          rows="2"
          value="{{product_data.product_detail}}"
        >
      </div>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Category</label>
          <input
            type="text"
            class="form-control"
            name="category"
            value="{{product_data.category}}"
          >
        </div>

        <div class="col-md-3 mb-3">
          <label class="form-label">Price</label>
          <input
            type="number"
            class="form-control"
            name="price"
            value="{{product_data.price}}"
          >
        </div>

        <div class="col-md-3 mb-3">
          <label class="form-label">GST (%)</label>
          <input
            type="number"
            class="form-control"
            name="gst"
            value="{{product_data.gst}}"
          >
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea
          class="form-control"
          name="description"
          rows="3"
        >{{product_data.description}}</textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Note</label>
        <textarea
          class="form-control"
          name="note"
          rows="2"
        >{{product_data.note}}</textarea>
      </div>
      <div class="mb-3">
        <label class="form-label">Fabric</label>
        <input
          class="form-control"
          name="fabric"
          rows="2"
          value="{{product_data.fabric}}"
        >
      </div>
      <div class="mb-3">
        <label class="form-label">Neckline</label>
        <input
          class="form-control"
          name="neckline"
          rows="2"
          value="{{product_data.neckline}}"
        >
      </div>
      <div class="mb-3">
        <label class="form-label">Occasios</label>
        <input
          class="form-control"
          name="occassion"
          rows="2"
          value="{{product_data.occasion}}"
        >
      </div>
      <div class="mb-3">
        <label class="form-label">Sleeve Length</label>
        <input
          class="form-control"
          name="sleeve_length"
          rows="2"
          value="{{product_data.sleeve_length}}"
        >
      </div>
      <div class="mb-3">
        <label class="form-label">size & fit note</label>
        <input
          class="form-control"
          name="size_and_fit_note"
          rows="2"
          value="{{product_data.size_and_fit_note}}"
        >
      </div>
      </div>
       <div class="d-flex justify-content-between mt-4">
        <a href="/admin/allProduct" class="btn btn-outline-secondary">
          Cancel
        </a>
        <button type="submit" class="btn btn-primary px-4">
          Update Product
        </button>
      </div>
    </div>
  </div>
</form>
